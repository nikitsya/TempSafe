# Local development only. Choose separate passwords before the first start.
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
MYSQL_PASSWORD=replace-with-your-local-tempsafe-password
MYSQL_PORT=3307

# Backend connection settings for the local Docker database.
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=tempsafe
MYSQL_USER=tempsafe

# Optional HTTP ingestion for the assigned device. Generate a separate random key.
TEMPSAFE_DEVICE_KEY=
TEMPSAFE_DEVICE_BOX_ID=TS-01

# Optional operator-only configuration API. Use a random secret of at least 32 characters.
# Leave empty to disable configuration access. Never put this token in browser code.
TEMPSAFE_CONFIG_ADMIN_TOKEN=

# FastMQTT runs inside FastAPI. Enable only with valid broker credentials.
# Run one Uvicorn worker; use a different client ID for local broker tests.
MQTT_ENABLED=false
MQTT_HOST=mqtt.tempsafe.app
MQTT_PORT=8883
MQTT_USERNAME=backend-ingest
MQTT_PASSWORD=
MQTT_BOX_ID=TS-01
MQTT_CLIENT_ID=tempsafe-api-TS-01
# Optional custom CA bundle; the operating system trust store is used otherwise.
MQTT_CA_FILE=
