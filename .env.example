# Local development only. Choose separate passwords before the first start.
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
MYSQL_PASSWORD=replace-with-your-local-temsafe-password
MYSQL_PORT=3307

# Backend connection settings for the local Docker database.
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=temsafe
MYSQL_USER=temsafe

# Optional HTTP ingestion for the assigned device. Generate a separate random key.
TEMSAFE_DEVICE_KEY=
TEMSAFE_DEVICE_BOX_ID=TS-01

# Optional operator-only configuration API. Use a random secret of at least 32 characters.
# Leave empty to disable configuration access. Never put this token in browser code.
TEMSAFE_CONFIG_ADMIN_TOKEN=
